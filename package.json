{
  "name": "resume-analyser",
  "version": "1.0.0",
  "private": true,
  "description": "AI Resume Analyser — Production-ready Full-Stack Application",
  "scripts": {
    "dev": "concurrently -k --names \"backend,frontend\" -c \"blue.bold,magenta.bold\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && python -m uvicorn app.main:app --port 8000 --reload",
    "dev:frontend": "cd frontend && npm run dev",
    "postinstall": "npm install --prefix frontend",
    "test:backend": "cd backend && python -m pytest -v",
    "build": "npm run build --prefix frontend",
    "lint": "npm run lint --prefix frontend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
